/* The page body is padded to line up with the shared page title, which already
   carries a 16px horizontal padding of its own. */
.body {
    padding: 0 16px 24px;
}

.desc {
    max-width: 620px;
    margin: 8px 0 0;
    color: var(--default-description-text);
}

.toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;

    @media (min-width: 768px) {
        gap: 12px;
        margin-top: 16px;
    }
}

/* One scrollable row instead of several wrapped ones keeps the filter bar to a
   single line on a phone. */
.chips {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1 1 100%;
    flex-wrap: nowrap;
    min-width: 0;
    order: 2;
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }

    @media (min-width: 768px) {
        flex: 1 1 auto;
        flex-wrap: wrap;
        order: 0;
        overflow-x: visible;
    }
}

.chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border: 1px solid var(--default-item-divider);
    border-radius: 14px;
    background: none;
    color: var(--default-main-text);
    font-family: inherit;
    font-size: var(--fs-text-t3);
    line-height: 1;
    white-space: nowrap;
    flex: 0 0 auto;
    cursor: pointer;
    transition:
        var(--t2) background-color,
        var(--t2) color,
        var(--t2) border-color;

    @media (hover: hover) {
        &:hover {
            background: var(--hovered-page-background);
        }
    }

    &:focus-visible {
        outline: 2px solid var(--default-active-input-stroke);
        outline-offset: 1px;
    }
}

.chipActive {
    border-color: transparent;
    background: var(--default-main-button);
    color: var(--gray-0);

    @media (hover: hover) {
        &:hover {
            background: var(--default-main-button);
        }
    }
}

.chipCount {
    font-size: var(--fs-text-t4);
    opacity: 0.65;
}

.toolbarActions {
    display: flex;
    align-items: center;
    gap: 8px;
    order: 1;

    @media (min-width: 768px) {
        gap: 12px;
        margin-left: auto;
        order: 0;
    }
}

/* Toolbar action, sized to sit next to the chips.  The shared Button carries a
   200px minimum width, which would tear the row apart. */
.toolButton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--default-item-divider);
    border-radius: 8px;
    background: var(--default-cards-background);
    color: var(--default-main-text);
    font-family: inherit;
    font-size: var(--fs-text-t3);
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: var(--t2) background-color;

    @media (min-width: 768px) {
        height: 36px;
        padding: 0 14px;
    }

    @media (hover: hover) {
        &:hover:not(:disabled) {
            background: var(--hovered-page-background);
        }
    }

    &:disabled {
        color: var(--default-description-text);
        cursor: default;
        opacity: 0.5;
    }

    &:focus-visible {
        outline: 2px solid var(--default-active-input-stroke);
        outline-offset: 1px;
    }
}

.tableSection {
    margin-top: 12px;
    padding-bottom: 24px;
}

.tableSection .tableRows {
    @media (max-width: 767px) {
        gap: 6px;
    }
}

@media (max-width: 767px) {
    /* The shared card carries 8px of vertical padding and puts 16px between the
       cards, which is a lot of air for a list that should show several messages
       per screen on a phone.  Two classes are needed to outrank the shared
       styles, and the compaction must not leak onto the desktop rows, whose
       padding the shared table already zeroes. */
    .tableSection .cardRow {
        padding: 4px 10px;
        /* Every value in a card resolves the shared type token, and the 24px
           line height of the 16px size is what actually makes the rows tall: a
           cell is one line plus a few pixels of padding.  Re-scoping the tokens
           on the card shrinks all of them at once. */
        --fs-text-t2: 14px;
        --lh-t2-normal: 18px;
    }

    /* The shared table never sets a size on a cell's value or label, so both
       inherit the page's 16px.  The label is a caption rather than content, so
       it goes smaller than the value and turns grey. */
    .tableSection .cardRow > * > * {
        padding: 2px 0;
        font-size: 14px;
        line-height: 18px;
    }

    .tableSection .cellLabel {
        color: var(--default-description-text);
        font-size: 12px;
        line-height: 16px;
    }
}

/* The badges of the status column.  On a card they wrap rather than overflow. */
.badges {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    min-width: 0;
}

.badge {
    display: inline-block;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--page-background-additional);
    color: var(--default-description-text);
    font-size: var(--fs-text-t4);
    line-height: var(--lh-t4-normal);
    white-space: nowrap;
}

.badgeUnread {
    background: var(--default-warning-button);
    color: var(--default-primary-button-text);
}

.badgeResolved {
    background: var(--fills-switch-on-default);
    color: var(--default-primary-button-text);
}

/* Private is outlined rather than filled so it does not read as another unread
   badge next to the orange one. */
.badgePrivate {
    border: 1px solid var(--default-warning-button);
    background: none;
    color: var(--default-warning-button);
}

/* The name and its identifier share one line; only the name gives up space. */
.userBox {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
}

.userName {
    flex: 0 1 auto;
    overflow: hidden;
    color: var(--default-main-text);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.userUid {
    flex: 0 0 auto;
    max-width: 45%;
    overflow: hidden;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--page-background-additional);
    color: var(--default-description-text);
    font-size: var(--fs-text-t4);
    line-height: var(--lh-t4-normal);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.actionsCellOuter {
    min-width: 0;
}

.actionsHeader {
    width: 100%;
    text-align: right;
}

/* The shared action container stacks its buttons on a phone, which costs a
   whole card's worth of height for three actions.  This one keeps them on a
   single wrapping line, so the row reads as one toolbar. */
.tableSection .actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px 12px;
    flex-wrap: wrap;
    width: 100%;

    @media (min-width: 768px) {
        width: auto;
        gap: 8px;
        flex-wrap: nowrap;
        justify-content: flex-end;
    }
}

.empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--default-description-text);
}

.emptyIcon {
    width: 40px;
    height: 40px;
    color: var(--default-gray-icons);
}
