.dialog {
    width: 420px;
    max-width: calc(100vw - 32px);
}

.footer {
    justify-content: flex-end;
}

/* The shared dialog body carries no horizontal padding of its own, while the
   header and the footer each add 16px.  Padding the body keeps the field on the
   same left/right edge as the title and the buttons. */
.body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 16px;
}

.hint {
    color: var(--default-description-text);
    font-size: var(--fs-text-t4);
    line-height: var(--lh-t4-normal);
}

.state {
    color: var(--default-description-text);
    font-size: var(--fs-text-t3);
    line-height: var(--lh-t3-normal);
}

.input {
    height: 34px;
    font-size: 14px;
}
